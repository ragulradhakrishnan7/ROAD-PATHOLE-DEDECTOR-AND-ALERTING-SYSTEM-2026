# Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=super-secret-jwt-key-pothole-detector-2026-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, PostgreSQL optional)
DATABASE_URL=sqlite:///./road_potholes.db
# DATABASE_URL=postgresql://pothole_user:pothole_password@localhost:5432/pothole_db

# Google Maps API (Optional: Leaflet/OpenStreetMap fallback used by default if empty)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging & Storage Configuration (Optional)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# AI Model Configuration
YOLO_MODEL_PATH=ai/weights/yolov8n_pothole.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.5
